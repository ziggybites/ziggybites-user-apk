{
  "dart.flutterSdkPath": ".fvm/flutter_sdk",
  "dart.openDevTools": "never",
  "search.exclude": {
    "**/.fvm": true,
    "**/.sst": true
  },
  "files.watcherExclude": {
    "**/.fvm/**": true,
    "**/build/**": true
  },
  "terminal.integrated.inheritEnv": true,
  "task.allowAutomaticTasks": "off"
}
